# Search extension - API keys (loaded via dotenv from this file)
# Copy to .env and fill in. Missing entries disable their adapter; the
# /search-check command will report which are present.

# Tier 1: general web search
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
# OpenAI: NOT set here. Reuse the OAuth in ~/.pi/agent/auth.json via
# ctx.modelRegistry so the extension never sees a separate key.

# Tier 2: specific-site / extract
JINA_API_KEY=
# CRAWL4AI_BASE_URL= # default http://localhost:11235 if you run the docker/CLI locally
# CRAVL4AI_API_KEY= # optional, some deployments require it

# Tool knobs (optional)
# SEARCH_DEFAULT_VERBOSITY=normal     # concise | normal | detailed
# SEARCH_DEFAULT_MAX_RESULTS=5
# SEARCH_HTTP_TIMEOUT_MS=15000

# Classifier (Jev, provided by Pi via typesafe)
# No key needed here; Pi reads TYPESAFE_API_KEY from auth.json.
